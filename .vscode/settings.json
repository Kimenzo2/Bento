{
  // ─── CSS ────────────────────────────────────────────────────────────────────
  "css.lint.unknownAtRules": "ignore",

  // ─── TypeScript performance ──────────────────────────────────────────────────
  // Use the workspace TypeScript instead of VS Code's bundled one
  "typescript.tsdk": "node_modules/typescript/lib",
  // Disable the slow tsserver project-wide actions on file open
  "typescript.disableAutomaticTypeAcquisition": true,
  // Faster completions — skip auto-import indexing for large projects
  "typescript.preferences.includePackageJsonAutoImports": "off",
  // Use the new project-wide rename/find (faster than old reindex approach)
  "typescript.experimental.updateImportsOnPaste": true,
  // Reduce re-analysis on each keystroke
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove.enabled": "always",

  // ─── File watcher exclusions (huge perf boost on Windows) ───────────────────
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/dev-dist/**": true,
    "**/.vite/**": true,
    "**/node_modules/.vite/**": true,
    "**/node_modules/.cache/**": true,
    "**/*.tsbuildinfo": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/dev-dist": true,
    "**/.vite": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/dev-dist": true,
    "**/.vite": true,
    "**/*.tsbuildinfo": true,
    "**/node_modules/.cache": true
  },

  // ─── ESLint / Biome ─────────────────────────────────────────────────────────
  // Run Biome only on save (not on type) — avoids linting on every keystroke
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
  "[json]": { "editor.defaultFormatter": "biomejs.biome" },
  "[jsonc]": { "editor.defaultFormatter": "biomejs.biome" },
  // Disable ESLint auto-fix on save to avoid double-processing with Biome
  "eslint.run": "onSave",

  // ─── Terminal / Shell ────────────────────────────────────────────────────────
  // Skip PowerShell profile loading for extension terminals (faster startup)
  "terminal.integrated.shellArgs.windows": ["-NoLogo"],
  "terminal.integrated.env.windows": {
    "NODE_OPTIONS": "--max-old-space-size=8192 --max-semi-space-size=256"
  },

  // ─── Editor misc ───────────────────────────────────────────────────────────
  "editor.linkedEditing": true,
  "editor.suggest.preview": false,
  "editor.quickSuggestionsDelay": 100
}

