{
  "name": "genesis-ebook-generator",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "dev:fast": "vite",
    "mastra:dev": "tsx --watch mastra/server.ts",
    "dev:all": "npm run mastra:dev & npm run dev",
    "build": "node scripts/parallel-build.mjs",
    "build:prod": "tsc -b && vite build --mode production",
    "build:analyze": "ANALYZE=true vite build",
    "lint": "biome check . --diagnostic-level=error",
    "lint:eslint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit --incremental false",
    "type-check:fast": "tsc --noEmit",
    "preview": "vite preview",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "clean": "rimraf dist .tsbuildinfo tsconfig.tsbuildinfo node_modules/.vite node_modules/.cache",
    "clean:all": "rimraf dist .tsbuildinfo tsconfig.tsbuildinfo node_modules/.vite node_modules/.cache",
    "setup:fast": "powershell -ExecutionPolicy Bypass -File fast-setup.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix"
  },
