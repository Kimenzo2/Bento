{
  "name": "bento-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/landing",
    "apps/genesis-desktop"
  ],
  "scripts": {
    "build": "turbo build --filter=@bento/landing",
    "dev:landing": "turbo dev --filter=@bento/landing",
    "dev:desktop": "turbo dev --filter=@bento/desktop",
    "build:landing": "turbo build --filter=@bento/landing",
    "build:desktop": "turbo build --filter=@bento/desktop",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run format:check && bun run lint",
    "type-check": "turbo type-check",
    "test": "turbo test"
  },
  "devDependencies": {
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "turbo": "^2.8.20",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.3.11"
}
