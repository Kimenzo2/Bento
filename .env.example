# ===========================================
# Genesis Environment Variables Template
# ===========================================
# Copy this to .env for local development
# For Vercel: Dashboard → Settings → Environment Variables
# ───────────────────────────────────────────
# KEY PREFIX RULES:
#   VITE_  → exposed to the browser (safe: public keys, URLs only)
#   NO PREFIX → server-side only (secrets: API keys, service-role keys)
# ===========================================

# SUPABASE — Frontend (public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SUPABASE — Server-only (Mastra backend, never exposed to browser)
# Get from: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# MASTRA SERVER (Hono backend — runs separately from Vite/Vercel)
# Port the Mastra HTTP server listens on (default 4111)
MASTRA_SERVER_PORT=4111
# Frontend URL for CORS allowlist
VITE_APP_URL=https://your-genesis-app.vercel.app
# Where the React frontend sends Mastra API requests
# Local dev: http://localhost:4111 | Production: your Railway/Render URL
VITE_MASTRA_URL=http://localhost:4111
# Optional: PostgreSQL connection string (auto-derived from SUPABASE_URL if omitted)
# MASTRA_PG_CONNECTION_STRING=postgresql://postgres.your-ref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Optional: Mastra Cloud access token for CloudExporter traces
# MASTRA_CLOUD_ACCESS_TOKEN=your_mastra_cloud_token

# GOOGLE AUTH (Required for Google One Tap sign-in)
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# IMPORTANT: Also add this Client ID to Supabase Dashboard:
#   → Authentication → Providers → Google → "Client IDs" field
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# AI APIs - Gemini
# Get from: https://makersuite.google.com/app/apikey
#
# ⚠️  MIGRATION NOTE:
#   With Mastra, AI calls happen server-side. Add un-prefixed keys for the
#   Mastra server. The VITE_ prefixed versions below are kept ONLY for the
#   legacy client-side fallback path while migration is in progress.
#   Once migration is complete, remove all VITE_GEMINI_* keys.
#
# Server-side (Mastra agents — preferred, no browser exposure)
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_API_KEY_4=your_gemini_api_key_4
GEMINI_API_KEY_5=your_gemini_api_key_5
# Client-side fallback (legacy path — deprecate once Mastra is stable)
VITE_GEMINI_API_KEY_1=your_gemini_api_key_1
VITE_GEMINI_API_KEY_2=your_gemini_api_key_2
VITE_GEMINI_API_KEY_3=your_gemini_api_key_3
VITE_GEMINI_API_KEY_4=your_gemini_api_key_4
VITE_GEMINI_API_KEY_5=your_gemini_api_key_5
VITE_GEMINI_API_KEY_6=your_gemini_api_key_6
VITE_GEMINI_API_KEY_7=your_gemini_api_key_7
VITE_GEMINI_API_KEY_8=your_gemini_api_key_8
VITE_GEMINI_API_KEY_9=your_gemini_api_key_9
VITE_GEMINI_API_KEY_10=your_gemini_api_key_10
VITE_GEMINI_API_KEY_11=your_gemini_api_key_11

# AI APIs - Bytez (Green Room character conversations)
# Get from: https://bytez.com/dashboard
# Server-side (Mastra — preferred)
BYTEZ_API_KEY=your_bytez_api_key
# Client-side fallback (legacy)
VITE_BYTEZ_API_KEY_1=your_bytez_api_key_1
VITE_BYTEZ_API_KEY_2=your_bytez_api_key_2
VITE_BYTEZ_API_KEY_3=your_bytez_api_key_3
VITE_BYTEZ_API_KEY_4=your_bytez_api_key_4
VITE_BYTEZ_API_KEY_5=your_bytez_api_key_5
VITE_BYTEZ_API_KEY_6=your_bytez_api_key_6
VITE_BYTEZ_API_KEY_7=your_bytez_api_key_7
VITE_BYTEZ_API_KEY_8=your_bytez_api_key_8
VITE_BYTEZ_API_KEY_9=your_bytez_api_key_9
VITE_BYTEZ_API_KEY_10=your_bytez_api_key_10
VITE_BYTEZ_API_KEY_11=your_bytez_api_key_11

# AI APIs - Gen Engine (Gen AI companion)
# VITE_GEMINI_API_KEY is shared with existing Gemini config above
# ElevenLabs for Gen's voice: https://elevenlabs.io/
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Gen's voice ID from ElevenLabs voice library
VITE_GEN_VOICE_ID=your_elevenlabs_voice_id

# OPTIONAL - Debug logging (false in production)
VITE_DEBUG=false

# ===========================================
# ERROR MONITORING - Rollbar
# ===========================================
# Get from: Rollbar Dashboard → Project Settings → Project Access Tokens
# Use the "post_client_item" token (NOT the "write" token)
# 
# PASTE YOUR ROLLBAR ACCESS TOKEN BELOW:
VITE_ROLLBAR_ACCESS_TOKEN=

# ─── RESEND EMAIL ───────────────────────────────────────────────────────────
# Full-access API key — Get from: https://resend.com/api-keys
# Sending domain: iamazeyou.me (verified in Resend dashboard)
RESEND_API_KEY=your_resend_api_key_here

# ─── DODO PAYMENTS ──────────────────────────────────────────────────────────
# Server-side only — bearer token for Dodo SDK
DODO_PAYMENTS_API_KEY=your_dodo_api_key_here
# Webhook signature verification secret (from Dodo Dashboard → Webhooks)
DODO_PAYMENTS_WEBHOOK_SECRET=your_dodo_webhook_secret_here
# Environment: 'test_mode' or 'live_mode'
DODO_PAYMENTS_ENV=live_mode
# Product IDs (from Dodo Dashboard → Products)
DODO_PRODUCT_ID_CREATOR_MONTHLY=your_dodo_creator_product_id
DODO_PRODUCT_ID_STUDIO_MONTHLY=your_dodo_studio_product_id
DODO_PRODUCT_ID_EMPIRE_MONTHLY=your_dodo_empire_product_id

