# ============================================================================
# MARS-CLASS INFRASTRUCTURE ENVIRONMENT CONFIGURATION
# Genesis Enhanced Visual Edutainment Platform
# Target: 1,000,000 Concurrent Users
# ============================================================================

# ----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ----------------------------------------------------------------------------
# Main Supabase project
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supavisor Connection Pooling (IPv6)
# Format: postgres://[username]:[password]@[pooler-host]:6543/[database]?sslmode=require
# Get from Supabase Dashboard > Settings > Database > Connection String > Pooling
SUPAVISOR_DATABASE_URL=postgres://postgres.your-ref:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Direct connection (for migrations only)
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.your-ref.supabase.co:5432/postgres

# ----------------------------------------------------------------------------
# REDIS CONFIGURATION (for BullMQ)
# ----------------------------------------------------------------------------
# Recommended: Upstash Redis (serverless, ~$0.50 per 100k commands)
# or Railway Redis / Render Redis for persistent workers

# Primary Redis for job queue
REDIS_URL=redis://default:your-password@your-redis-host.upstash.io:6379

# Redis connection settings
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000
REDIS_ENABLE_TLS=true

# ----------------------------------------------------------------------------
# CLOUDFLARE R2 STORAGE (Zero Egress)
# ----------------------------------------------------------------------------
# Create bucket at: https://dash.cloudflare.com > R2

# R2 API credentials
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key

# R2 bucket configuration
R2_BUCKET_NAME=genesis-assets
R2_PUBLIC_BUCKET_URL=https://genesis-assets.your-account.r2.dev
R2_CUSTOM_DOMAIN=https://cdn.yourdomain.com

# R2 region (auto or specific)
R2_REGION=auto

# ----------------------------------------------------------------------------
# CLOUDFLARE CDN & WORKERS
# ----------------------------------------------------------------------------
# For image optimization worker
CF_API_TOKEN=your-cloudflare-api-token
CF_ZONE_ID=your-zone-id

# Image optimization endpoint (Cloudflare Worker)
IMAGE_OPTIMIZATION_WORKER_URL=https://img-optimizer.your-domain.workers.dev

# ----------------------------------------------------------------------------
# OPENTELEMETRY OBSERVABILITY
# ----------------------------------------------------------------------------
# Recommended: Honeycomb, Jaeger, or Grafana Tempo

# OTLP endpoint for traces
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io:443
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=your-api-key

# Or for Grafana Tempo
# OTEL_EXPORTER_OTLP_ENDPOINT=https://tempo.yourdomain.com:4318

# Service identification
OTEL_SERVICE_NAME=genesis-production
OTEL_SERVICE_VERSION=1.0.0
OTEL_DEPLOYMENT_ENVIRONMENT=production

# Sampling rate (0.0 to 1.0)
# 1.0 = 100% of traces, 0.1 = 10% of traces
OTEL_SAMPLING_RATIO=0.1

# ----------------------------------------------------------------------------
# AI SERVICES (DO NOT MODIFY - Per User Instructions)
# ----------------------------------------------------------------------------
# These are referenced but not modified by Mars-Class infrastructure
VITE_GEMINI_API_KEY=your-gemini-key
VITE_IMAGEN_ENABLED=true

# ----------------------------------------------------------------------------
# SEMANTIC CACHE CONFIGURATION
# ----------------------------------------------------------------------------
# Embedding model for semantic similarity
EMBEDDING_MODEL_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# Cache thresholds
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_ENTRIES=10000
SEMANTIC_CACHE_TTL_HOURS=168

# Cost tracking (for analytics)
AI_COST_PER_1K_TOKENS=0.00025
AI_COST_PER_IMAGE=0.020

# ----------------------------------------------------------------------------
# JOB QUEUE CONFIGURATION
# ----------------------------------------------------------------------------
# Worker configuration
JOB_QUEUE_CONCURRENCY=10
JOB_QUEUE_MAX_RETRIES=3
JOB_QUEUE_RETRY_DELAY=5000

# Timeout settings (in milliseconds)
JOB_TIMEOUT_BOOK_GENERATION=180000
JOB_TIMEOUT_IMAGE_OPTIMIZATION=60000
JOB_TIMEOUT_CURRICULUM=120000

# Queue names
JOB_QUEUE_CRITICAL=genesis:critical
JOB_QUEUE_HIGH=genesis:high
JOB_QUEUE_NORMAL=genesis:normal
JOB_QUEUE_LOW=genesis:low

# ----------------------------------------------------------------------------
# MEDIA OPTIMIZATION
# ----------------------------------------------------------------------------
# Sharp configuration
SHARP_CONCURRENCY=4
SHARP_CACHE_SIZE=50

# Output quality settings
IMAGE_QUALITY_WEBP=85
IMAGE_QUALITY_AVIF=80
IMAGE_QUALITY_JPEG=90

# Maximum dimensions
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1920

# Responsive breakpoints
IMAGE_BREAKPOINTS=320,640,960,1280,1920

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
# Per-user limits
RATE_LIMIT_BOOKS_PER_HOUR=10
RATE_LIMIT_AI_CALLS_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_HOUR=50

# Global limits (protection)
RATE_LIMIT_GLOBAL_RPS=10000

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------
# Mars-Class features
FEATURE_SEMANTIC_CACHE=true
FEATURE_R2_STORAGE=true
FEATURE_JOB_QUEUE=true
FEATURE_DISTRIBUTED_TRACING=true
FEATURE_MEDIA_OPTIMIZATION=true

# Gradual rollout (percentage)
FEATURE_ROLLOUT_SEMANTIC_CACHE=100
FEATURE_ROLLOUT_R2_STORAGE=100

# ----------------------------------------------------------------------------
# DEPLOYMENT CONFIGURATION
# ----------------------------------------------------------------------------
# Vercel
VERCEL_URL=https://iamazeyou.me

# Worker deployment (Fly.io or Railway)
WORKER_URL=https://genesis-worker.fly.dev
WORKER_REGION=iad

# ----------------------------------------------------------------------------
# MONITORING & ALERTING
# ----------------------------------------------------------------------------
# PagerDuty (for critical alerts)
PAGERDUTY_ROUTING_KEY=your-pagerduty-key

# Slack webhook (for notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Alert thresholds
ALERT_ERROR_RATE_THRESHOLD=0.01
ALERT_P95_LATENCY_MS=5000
ALERT_CACHE_HIT_RATE_MIN=0.30

# ============================================================================
# VERCEL MARKETPLACE INTEGRATIONS
# ============================================================================

# ----------------------------------------------------------------------------
# UPSTASH REDIS (Rate Limiting & Caching)
# https://vercel.com/marketplace/upstash
# ----------------------------------------------------------------------------
VITE_UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
VITE_UPSTASH_REDIS_REST_TOKEN=your-upstash-token
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ----------------------------------------------------------------------------
# SENTRY (Error Tracking & Performance)
# https://vercel.com/marketplace/sentry
# ----------------------------------------------------------------------------
VITE_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-org
SENTRY_PROJECT=genesis
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# ----------------------------------------------------------------------------
# STATSIG (Feature Flags & Experimentation)
# https://vercel.com/marketplace/statsig
# ----------------------------------------------------------------------------
VITE_STATSIG_CLIENT_KEY=client-your-statsig-key
STATSIG_SERVER_SECRET=secret-your-statsig-key
VITE_STATSIG_ENVIRONMENT=production

# ----------------------------------------------------------------------------
# HYPERDX (Observability & Logging)
# https://vercel.com/marketplace/hyperdx
# ----------------------------------------------------------------------------
VITE_HYPERDX_API_KEY=your-hyperdx-api-key
HYPERDX_API_KEY=your-hyperdx-api-key

# ----------------------------------------------------------------------------
# CHECKLY (Synthetic Monitoring)
# https://vercel.com/marketplace/checkly
# ----------------------------------------------------------------------------
CHECKLY_API_KEY=your-checkly-api-key
CHECKLY_ACCOUNT_ID=your-checkly-account-id

# ----------------------------------------------------------------------------
# ARCJET (Security - Rate Limiting, Bot Protection)
# https://vercel.com/marketplace/arcjet
# ----------------------------------------------------------------------------
ARCJET_KEY=your-arcjet-key
VITE_ARCJET_KEY=your-arcjet-key

# ============================================================================
# EXTENDED VERCEL MARKETPLACE INTEGRATIONS
# ============================================================================

# ----------------------------------------------------------------------------
# RESEND (Transactional Email)
# https://vercel.com/marketplace/resend
# ----------------------------------------------------------------------------
VITE_RESEND_API_KEY=re_your-resend-api-key
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=Genesis <hello@iamazeyou.me>

# ----------------------------------------------------------------------------
# KNOCK (Multi-Channel Notifications)
# https://vercel.com/marketplace/knock
# ----------------------------------------------------------------------------
VITE_KNOCK_API_KEY=sk_your-knock-secret-key
VITE_KNOCK_PUBLIC_API_KEY=pk_your-knock-public-key
KNOCK_API_KEY=sk_your-knock-secret-key
VITE_KNOCK_FEED_CHANNEL_ID=in-app-feed

# ----------------------------------------------------------------------------
# ELEVENLABS (AI Voice & Audiobook)
# https://vercel.com/marketplace/elevenlabs
# ----------------------------------------------------------------------------
VITE_ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ----------------------------------------------------------------------------
# MUX (Video Streaming)
# https://vercel.com/marketplace/mux
# ----------------------------------------------------------------------------
VITE_MUX_TOKEN_ID=your-mux-token-id
VITE_MUX_TOKEN_SECRET=your-mux-token-secret
MUX_TOKEN_ID=your-mux-token-id
MUX_TOKEN_SECRET=your-mux-token-secret
MUX_WEBHOOK_SECRET=your-mux-webhook-secret

# ----------------------------------------------------------------------------
# CLOUDINARY (Image & Media Optimization)
# https://cloudinary.com
# ----------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_API_KEY=your-api-key
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ----------------------------------------------------------------------------
# ALGOLIA (Search)
# https://vercel.com/marketplace/algolia
# ----------------------------------------------------------------------------
VITE_ALGOLIA_APP_ID=your-algolia-app-id
VITE_ALGOLIA_SEARCH_API_KEY=your-algolia-search-key
VITE_ALGOLIA_WRITE_API_KEY=your-algolia-write-key
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_ADMIN_KEY=your-algolia-admin-key

# ----------------------------------------------------------------------------
# LIVEBLOCKS (Real-Time Collaboration)
# https://vercel.com/marketplace/liveblocks
# ----------------------------------------------------------------------------
VITE_LIVEBLOCKS_PUBLIC_KEY=pk_your-liveblocks-public-key
VITE_LIVEBLOCKS_SECRET_KEY=sk_your-liveblocks-secret-key
LIVEBLOCKS_SECRET_KEY=sk_your-liveblocks-secret-key

# ----------------------------------------------------------------------------
# INNGEST (Background Jobs & Workflows)
# https://vercel.com/marketplace/inngest
# ----------------------------------------------------------------------------
VITE_INNGEST_EVENT_KEY=your-inngest-event-key
VITE_INNGEST_SIGNING_KEY=your-inngest-signing-key
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# ----------------------------------------------------------------------------
# POSTHOG (Product Analytics)
# https://vercel.com/marketplace/posthog
# ----------------------------------------------------------------------------
VITE_POSTHOG_API_KEY=phc_your-posthog-project-api-key
POSTHOG_API_KEY=phc_your-posthog-project-api-key
VITE_POSTHOG_HOST=https://app.posthog.com

# ----------------------------------------------------------------------------
# DEVELOPMENT OVERRIDES
# ----------------------------------------------------------------------------
# These are used in development mode

# Use local Redis
# DEV_REDIS_URL=redis://localhost:6379

# Use local MinIO instead of R2
# DEV_S3_ENDPOINT=http://localhost:9000
# DEV_S3_ACCESS_KEY=minioadmin
# DEV_S3_SECRET_KEY=minioadmin

# Disable distributed tracing locally
# DEV_DISABLE_TRACING=true

# Use in-memory cache instead of Redis
# DEV_CACHE_MODE=memory

# Disable integrations locally
# VITE_DISABLE_SENTRY=true
# VITE_DISABLE_STATSIG=true
# VITE_DISABLE_HYPERDX=true
