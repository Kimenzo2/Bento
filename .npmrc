# ─── npm performance ─────────────────────────────────
# Prefer faster registry
registry=https://registry.npmjs.org/

# Fix peer dependency conflicts for Vite 8 and ESLint 10
legacy-peer-deps=true

# Disable progress bar (significant speed gain in CI/Windows terminals)
progress=false

# Disable audit on every install (run manually with npm audit)
audit=false

# Disable fund messages
fund=false

# Increase fetch retries / concurrency
fetch-retries=3
fetch-retry-mintimeout=5000
fetch-retry-maxtimeout=60000
maxsockets=15

# Prefer symlinks over extra copies where possible
prefer-dedupe=true
