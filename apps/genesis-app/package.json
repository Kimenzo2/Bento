{
  "name": "@genesis/app",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "dev:fast": "vite",
    "mastra:dev": "tsx --watch mastra/server.ts",
    "dev:all": "bun run mastra:dev & bun run dev",
    "build": "node scripts/parallel-build.mjs",
    "build:prod": "node node_modules/typescript/bin/tsc -b && vite build --mode production",
    "build:analyze": "ANALYZE=true vite build",
    "build:check": "bun run build && bun run size-check",
    "size-check": "node scripts/size-check.mjs",
    "lint": "biome check . --diagnostic-level=error",
    "lint:eslint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "node node_modules/typescript/bin/tsc --noEmit --incremental false",
    "type-check:fast": "node node_modules/typescript/bin/tsc --noEmit",
    "preview": "vite preview",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "clean": "rimraf dist .tsbuildinfo tsconfig.tsbuildinfo node_modules/.vite node_modules/.cache",
    "clean:all": "rimraf dist .tsbuildinfo tsconfig.tsbuildinfo node_modules/.vite node_modules/.cache",
    "setup:fast": "powershell -ExecutionPolicy Bypass -File ../../fast-setup.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:phase2": "playwright test e2e/phase2-gpu-no-editor.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "email": "email dev --dir emails --port 3001",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "i18n:sweep": "node scripts/sweep-hardcoded-i18n.mjs",
    "audit": "bun pm ls",
    "audit:fix": "bun update"
  },
