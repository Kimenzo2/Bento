# ============================================================================
# GENESIS INTEGRATIONS - ENVIRONMENT CONFIGURATION
# All Vercel Marketplace Integrations
# ============================================================================

# ----------------------------------------------------------------------------
# UPSTASH REDIS (Rate Limiting, Caching, Pub/Sub)
# Get from: https://console.upstash.com/
# ----------------------------------------------------------------------------

# REST API (for serverless - recommended)
VITE_UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
VITE_UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Standard Redis URL (for workers)
UPSTASH_REDIS_URL=rediss://default:your-password@your-redis.upstash.io:6379

# ----------------------------------------------------------------------------
# SENTRY (Error Tracking & Performance)
# Get from: https://sentry.io/settings/projects/
# ----------------------------------------------------------------------------

VITE_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
VITE_SENTRY_ENABLED=true

# Optional: Auth token for release tracking
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-org
SENTRY_PROJECT=genesis

# ----------------------------------------------------------------------------
# STATSIG (Feature Flags & Experimentation)
# Get from: https://console.statsig.com/
# ----------------------------------------------------------------------------

VITE_STATSIG_CLIENT_KEY=client-your-statsig-key

# Server-side key (for API routes)
STATSIG_SERVER_SECRET=secret-your-statsig-secret

# ----------------------------------------------------------------------------
# HYPERDX (Observability & Logging)
# Get from: https://www.hyperdx.io/team/api-keys
# ----------------------------------------------------------------------------

VITE_HYPERDX_API_KEY=your-hyperdx-api-key
VITE_HYPERDX_ENABLED=true

# Service name for traces
VITE_HYPERDX_SERVICE=genesis

# ----------------------------------------------------------------------------
# CHECKLY (Synthetic Monitoring)
# Get from: https://app.checklyhq.com/settings/account/api-keys
# ----------------------------------------------------------------------------

VITE_CHECKLY_ACCOUNT_ID=your-checkly-account-id
VITE_CHECKLY_API_KEY=your-checkly-api-key

# For Real User Monitoring (optional)
VITE_CHECKLY_SITE_ID=your-site-id

# ----------------------------------------------------------------------------
# ARCJET (Edge Security)
# Get from: https://app.arcjet.com/
# ----------------------------------------------------------------------------

VITE_ARCJET_KEY=your-arcjet-key

# ----------------------------------------------------------------------------
# BRAINTRUST (LLM Observability)
# Get from: https://www.braintrust.dev/
# ----------------------------------------------------------------------------

BRAINTRUST_API_KEY="bt-st-J0X2kXn77oJElV4bieG10cUVuQiVYyvsMyRMRY3BNyZ0yu1u"
BRAINTRUST_PROJECT_ID="917ee916-fe1f-460c-958d-37e8484dd8e2"

# ----------------------------------------------------------------------------
# VERCEL ANALYTICS (Already in package.json)
# Automatically configured by Vercel
# ----------------------------------------------------------------------------

# No configuration needed - uses @vercel/analytics

# ----------------------------------------------------------------------------
# ELEVENLABS (Voice - Future Integration)
# Get from: https://elevenlabs.io/
# ----------------------------------------------------------------------------

# VITE_ELEVENLABS_API_KEY=your-elevenlabs-key

# ----------------------------------------------------------------------------
# MUX (Video - Future Integration)
# Get from: https://dashboard.mux.com/
# ----------------------------------------------------------------------------

# MUX_TOKEN_ID=your-mux-token-id
# MUX_TOKEN_SECRET=your-mux-token-secret

# ----------------------------------------------------------------------------
# APPLICATION METADATA
# ----------------------------------------------------------------------------

VITE_APP_VERSION=2.0.0
VITE_APP_ENVIRONMENT=production

