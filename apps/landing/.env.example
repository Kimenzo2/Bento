# ===========================================
# Genesis Landing App Environment Variables
# ===========================================
# Copy this to .env.local for local development
# For Vercel: Dashboard → Settings → Environment Variables
# ───────────────────────────────────────────
# KEY PREFIX RULES:
#   NEXT_PUBLIC_  → exposed to the browser (safe: public keys, URLs only)
#   NO PREFIX     → server-side only (secrets: API keys, service-role keys)
#
# IMPORTANT: These variables MUST match the Vite app's values for auth to work
# ===========================================

# SUPABASE — Client-side (public, shared with Vite app)
# These values MUST match VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SUPABASE — Server-side only (for server components and API routes)
# This is the same service role key used by the Vite app's Mastra backend
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ===========================================
# OPTIONAL: Analytics & Monitoring
# ===========================================
# Vercel Analytics (auto-injected by Vercel, usually not needed locally)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# ===========================================
# DEV PROXY (for local development only)
# ===========================================
# The unified dev proxy URL (default: http://localhost:4000)
# Both apps are accessible through this single URL
NEXT_PUBLIC_APP_URL=http://localhost:4000
