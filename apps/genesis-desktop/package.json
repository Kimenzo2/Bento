{
  "name": "@bento/desktop",
  "version": "0.1.3",
  "private": true,
  "description": "Bento Desktop application",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run tauri dev",
    "dev:frontend": "svelte-kit sync && vite dev",
    "logs": "bun run dev:frontend",
    "build": "svelte-kit sync && vite build",
    "build:fast": "vite build --mode development && bun run tauri build --debug",
    "setup:vcpkg": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-vcpkg.ps1",
    "release:windows": "bun run tauri build --bundles nsis",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings \"a11y_interactive_supports_focus:ignore,a11y_no_static_element_interactions:ignore,a11y_consider_explicit_label:ignore,a11y_click_events_have_key_events:ignore,a11y_no_noninteractive_element_interactions:ignore,a11y_label_has_associated_control:ignore,a11y_no_noninteractive_element_to_interactive_role:ignore,css_unused_selector:ignore,svelte_component_deprecated:ignore\"",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "type-check": "bun run check",
    "type-check:fast": "tsgo --noEmit -p ./tsconfig.tsgo.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "tauri": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/tauri.ps1"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/noto-sans-arabic": "^5.2.10",
    "@fontsource/fredoka": "^5.2.10",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/merriweather": "^5.2.11",
    "@fontsource/poppins": "^5.2.7",
    "@fontsource/source-sans-pro": "^5.2.5",
    "@lucide/svelte": "^1.14.0",
    "@mastra/core": "^1.16.0",
    "@mastra/memory": "^1.10.0",
    "@mastra/observability": "^1.5.1",
    "@mastra/pg": "^1.8.3",
    "@mastra/rag": "^2.1.2",
    "@mateothegreat/svelte5-router": "^2.16.19",
    "@supabase/supabase-js": "^2.100.1",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.2",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.2",
    "@tauri-apps/plugin-notification": "^2.3.2",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.9.1",
    "@tauri-apps/plugin-window-state": "2.4.1",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "layerchart": "2.0.0-next.64",
    "lucide-svelte": "^1.0.1",
    "marked": "^18.0.3",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.3.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.27.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.8.5",
    "@testing-library/svelte": "^5.2.8",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^22.10.2",
    "@types/sortablejs": "^1.15.9",
    "@typescript/native-preview": "beta",
    "bits-ui": "^2.16.3",
    "jsdom": "^28.1.0",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "shadcn-svelte": "^1.2.7",
    "svelte": "^5.38.7",
    "svelte-check": "^4.3.1",
    "svelte-sonner": "^1.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^6.0.2",
    "vite": "^7.1.2",
    "vitest": "^4.1.2"
  },
  "packageManager": "bun@1.3.13"
}
