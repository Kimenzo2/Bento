{
  "name": "@bento/desktop",
  "version": "0.2.24",
  "private": true,
  "description": "Bento Desktop application",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run tauri dev",
    "build:proxy": "bun run proxy:build",
    "dev:frontend": "svelte-kit sync && vite dev",
    "logs": "bun run dev:frontend",
    "build": "svelte-kit sync && vite build",
    "build:fast": "vite build --mode development && bun run tauri build --debug",
    "setup:vcpkg": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-vcpkg.ps1",
    "release:windows": "bun run tauri build --bundles nsis",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --compiler-warnings \"a11y_interactive_supports_focus:ignore,a11y_no_static_element_interactions:ignore,a11y_consider_explicit_label:ignore,a11y_click_events_have_key_events:ignore,a11y_no_noninteractive_element_interactions:ignore,a11y_label_has_associated_control:ignore,a11y_no_noninteractive_element_to_interactive_role:ignore,css_unused_selector:ignore,svelte_component_deprecated:ignore,element_invalid_self_closing_tag:ignore\"",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "type-check": "bun run check",
    "type-check:fast": "tsgo --noEmit -p ./tsconfig.tsgo.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "proxy:build": "bun run proxy:build:win",
    "proxy:build:win": "bun install --cwd ../../apps/server && bun build --compile --target=bun-windows-x64-modern ../../apps/server/src/index.js --outfile ./src-tauri/binaries/chatgpt-proxy-x86_64-pc-windows-msvc",
    "proxy:build:linux": "bun install --cwd ../../apps/server && bun build --compile --target=bun-linux-x64-modern ../../apps/server/src/index.js --outfile ./src-tauri/binaries/chatgpt-proxy-x86_64-unknown-linux-gnu",
    "proxy:build:mac-x64": "bun install --cwd ../../apps/server && bun build --compile --target=bun-darwin-x64-modern ../../apps/server/src/index.js --outfile ./src-tauri/binaries/chatgpt-proxy-x86_64-apple-darwin",
    "proxy:build:mac-arm64": "bun install --cwd ../../apps/server && bun build --compile --target=bun-darwin-arm64-modern ../../apps/server/src/index.js --outfile ./src-tauri/binaries/chatgpt-proxy-aarch64-apple-darwin",
    "proxy:build:mac-universal": "bun run proxy:build:mac-x64 && bun run proxy:build:mac-arm64 && lipo -create -output ./src-tauri/binaries/chatgpt-proxy-universal-apple-darwin ./src-tauri/binaries/chatgpt-proxy-x86_64-apple-darwin ./src-tauri/binaries/chatgpt-proxy-aarch64-apple-darwin",
    "proxy:dev": "bun run ../../apps/server/src/index.js",
    "tauri": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/tauri.ps1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.14",
    "@ai-sdk/google": "^4.0.14",
    "@ai-sdk/openai": "^4.0.13",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.2.10",
    "@fontsource/fredoka": "^5.2.10",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/merriweather": "^5.2.11",
    "@fontsource/poppins": "^5.2.7",
    "@fontsource/source-sans-pro": "^5.2.5",
    "@lucide/svelte": "^1.14.0",
    "@mastra/core": "^1.16.0",
    "@mastra/memory": "^1.10.0",
    "@mastra/observability": "^1.5.1",
    "@mastra/pg": "^1.8.3",
    "@mastra/rag": "^2.1.2",
    "@mateothegreat/svelte5-router": "^2.16.19",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@supabase/supabase-js": "^2.100.1",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.2",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-notification": "^2.3.2",
    "@tauri-apps/plugin-opener": "2",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.9.1",
    "@tauri-apps/plugin-window-state": "2.4.1",
    "ai": "^7.0.26",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "dompurify": "^3.3.1",
    "layerchart": "2.0.0-next.64",
    "lucide-svelte": "^1.0.1",
    "marked": "^18.0.3",
    "runed": "^0.37.1",
    "shiki": "^4.0.2",
    "simple-icons": "^16.26.0",
    "sortablejs": "^1.15.7",
    "streamdown-svelte": "^3.0.6",
    "svelte-toolbelt": "^0.10.5",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.3.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.67.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.8.5",
    "@testing-library/svelte": "^5.2.8",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^22.10.2",
    "@types/sortablejs": "^1.15.9",
    "@typescript/native-preview": "beta",
    "bits-ui": "^2.16.3",
    "esbuild": "^0.28.1",
    "jsdom": "^28.1.0",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "shadcn-svelte": "^1.2.7",
    "svelte": "^5.56.4",
    "svelte-check": "^4.3.1",
    "svelte-sonner": "^1.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^6.0.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.2"
  },
  "packageManager": "bun@1.3.13"
}
