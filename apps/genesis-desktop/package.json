{
  "name": "@genesis/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Genesis Desktop application",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite dev",
    "build": "svelte-kit sync && vite build",
    "build:fast": "vite build --mode development && tauri build --debug",
    "release:windows": "bun run tauri build -- --bundles nsis",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "type-check": "bun run check",
    "type-check:fast": "tsgo --noEmit -p ./tsconfig.tsgo.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/tauri.ps1"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "^5.2.10",
    "@fontsource/fredoka": "^5.2.10",
    "@fontsource/manrope": "^5.2.8",
    "@lorenzootieno/gen-brain": "^0.0.1",
    "@lorenzootieno/gen-bridge": "^0.0.1",
    "@lorenzootieno/gen-renderer": "^0.0.1",
    "@lorenzootieno/gen-voice": "^0.0.1",
    "@lucide/svelte": "^1.14.0",
    "@mastra/core": "1.32.0",
    "@mastra/mcp": "1.7.0",
    "@mastra/memory": "1.17.5",
    "@mastra/observability": "1.11.1",
    "@mastra/pg": "1.10.0",
    "@mastra/rag": "2.2.1",
    "@mateothegreat/svelte5-router": "^2.16.19",
    "@supabase/supabase-js": "^2.100.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.2",
    "@tauri-apps/plugin-notification": "^2.3.2",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-updater": "^2.9.1",
    "@tauri-apps/plugin-window-state": "2.4.1",
    "bun-types": "^1.1.33",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.27.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "beta",
    "bits-ui": "^2.16.3",
    "jsdom": "^28.1.0",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "shadcn-svelte": "^1.2.7",
    "svelte": "^5.53.11",
    "svelte-check": "^4.4.5",
    "svelte-sonner": "^1.1.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "packageManager": "bun@1.3.13"
}
