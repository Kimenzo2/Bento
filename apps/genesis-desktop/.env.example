# ── AI Provider API Keys (for Vercel AI SDK API routes) ──────────────────
# These are read by the API routes at /api/agent during development.
# In production, keys are managed via the BYOK (Bring Your Own Key) system
# through Tauri's secure OS keyring store.
#
# At least ONE provider key is required for the agent to work.
#
# OpenAI:     https://platform.openai.com/api-keys
OPENAI_API_KEY=
#
# Anthropic:  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
#
# Google Gemini: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
#
# xAI (Grok): https://console.x.ai/
XAI_API_KEY=
#
# Ollama: Uses localhost:11434 by default — no API key needed.
# Set OLLAMA_BASE_URL if running on a different host/port.
OLLAMA_BASE_URL=http://localhost:11434/v1
