{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bento",
  "version": "0.1.0",
  "identifier": "me.iamazeyou.bentodesktop",
  "build": {
    "beforeDevCommand": "bun run dev:frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bento",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": false,
        "shadow": false,
        "transparent": false,
        "resizable": true,
        "visible": false,
        "center": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' module: http://module.localhost; style-src 'self' 'unsafe-inline' module: http://module.localhost; img-src 'self' data: https: module: http://module.localhost; font-src 'self' data: module: http://module.localhost; connect-src 'self' https://updates.iamazeyou.me https://api.iamazeyou.me module: http://module.localhost; frame-ancestors 'none'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/bento-mcp"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["bento"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4M0UwRkY2NDk2RTJFRjYKUldUMkxtNUo5ZzgrS09ObHB2LzhPMkZvOGtGUHZPUlVndmRQYWIrWHRyVG9LOGNielJPQjh1aW0K",
      "endpoints": ["https://updates.iamazeyou.me/bento-desktop"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
