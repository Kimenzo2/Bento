# ── Required ──────────────────────────────────────────────
# OpenAI API key for the proxy to use
OPENAI_API_KEY=sk-proj-...

# A random secret for signing session JWTs (generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-a-random-64-char-hex-string

# ── Optional ──────────────────────────────────────────────
# Port (defaults to 3001)
PORT=3001

# Allowed origins for CORS (comma-separated, defaults to http://localhost:1420,tauri://localhost)
ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost

# Default OpenAI model to use
OPENAI_MODEL=gpt-4o

# Max tokens per response
MAX_TOKENS=4096
