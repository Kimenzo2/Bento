# ── Required ──────────────────────────────────────────────
# Secret for signing session cookies (generate with: openssl rand -hex 32)
CHATGPT_SESSION_SECRET=replace-with-random-64-char-hex

# ── Optional ──────────────────────────────────────────────
# Port (defaults to 3001)
PORT=3001

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost,bento://
